<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.colors_primary | default: '#9c2f5f' }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  </head>
  <body class="smoothie-theme">
    {% if settings.show_announcement and settings.announcement_text != blank %}
      <div class="smoothie-announcement-bar" style="background-color: {{ settings.colors_primary | default: '#9c2f5f' }}; color: #ffffff; text-align: center; padding: 8px 12px; font-size: 13px; font-weight: 600;">
        {{ settings.announcement_text }}
      </div>
    {% endif %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
